rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return verified() && request.auth.token.email.lower() == 'devshadow8044@gmail.com'; }
    function isPatron() { return verified() && request.auth.token.email.lower() == 'papegning2008@gmail.com'; }

    match /users/{uid} {
      allow read: if verified();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if verified() &&
        (chatId == 'annonces' || request.auth.uid in chatId.split('_'));
      allow create: if verified() && request.resource.data.from == request.auth.uid &&
        ((chatId == 'annonces' && isOwner()) ||
         (chatId != 'annonces' && request.auth.uid in chatId.split('_')));
      allow update: if verified() && chatId != 'annonces' &&
        request.auth.uid in chatId.split('_') && resource.data.from != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    match /statuses/{sid} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.uid == request.auth.uid;
      allow delete: if verified() && resource.data.uid == request.auth.uid;
    }

    match /config/{doc} {
      allow read, write: if isOwner();
    }

    match /chantiers/{id} {
      allow read: if verified() && (isPatron() || request.auth.uid in resource.data.macons);
      allow write: if isPatron();
    }
  }
}
