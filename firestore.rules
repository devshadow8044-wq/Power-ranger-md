rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Compte connecté ET email confirmé
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return verified() && request.auth.token.email.lower() == 'devshadow8044@gmail.com'; }
    // l'autre personne d'une discussion "uidA_uidB"
    function other(chatId) { return chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]; }
    // l'autre personne ne m'a pas bloqué
    function notBlocked(chatId) { return !exists(/databases/$(database)/documents/users/$(other(chatId))/blocked/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if verified();
      allow write: if request.auth != null && request.auth.uid == uid;

      // mes contacts (privés)
      match /contacts/{id} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
      // mes contacts bloqués (privés : personne d'autre ne les voit)
      match /blocked/{id} {
        allow read, write: if verified() && request.auth.uid == uid;
      }
    }

    // aperçu de la discussion (dernier message, membres)
    match /chats/{chatId} {
      allow read: if verified() && (chatId == 'annonces' || request.auth.uid in resource.data.members);
      allow create, update: if verified() &&
        ((chatId == 'annonces' && isOwner()) ||
         (chatId != 'annonces' && request.auth.uid in chatId.split('_') &&
          request.resource.data.members == chatId.split('_') && notBlocked(chatId)));
    }

    match /chats/{chatId}/messages/{msgId} {
      allow read: if verified() &&
        (chatId == 'annonces' || request.auth.uid in chatId.split('_'));
      allow create: if verified() && request.resource.data.from == request.auth.uid &&
        ((chatId == 'annonces' && isOwner()) ||
         (chatId != 'annonces' && request.auth.uid in chatId.split('_') && notBlocked(chatId)));
    }
  }
}
